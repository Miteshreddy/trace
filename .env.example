# TRACE//QA Dual AI Provider Configuration Template
# Copy this file to .env and insert your real API keys.

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# AI Provider Selection: AUTO, GROQ, or GEMINI
AI_PROVIDER_MODE=AUTO

# Server & Target Application Configuration
HOST=127.0.0.1
PORT=8000
DEMO_URL=http://127.0.0.1:8000/demo/
